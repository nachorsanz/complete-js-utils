{
  "name": "complete-js-utils",
  "version": "1.1.0-rc",
  "description": "A complete utility library for JavaScript and TypeScript",
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/esm/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run-s build:cjs build:esm postbuild:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "postbuild:esm": "node scripts/fix-esm-extensions.cjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "update-version": "npm version prerelease --preid=alpha --no-git-tag-version",
    "update-version-patch": "npm version patch --no-git-tag-version",
    "update-version-minor": "npm version minor --no-git-tag-version",
    "update-version-major": "npm version major --no-git-tag-version"
  },
  "keywords": [
    "javascript",
    "typescript",
    "utilities",
    "utils",
    "library",
    "helpers",
    "date",
    "string",
    "array",
    "object",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nachorsanz/complete-js-utils.git"
  },
  "author": "Nacho Rodríguez Sanz",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
